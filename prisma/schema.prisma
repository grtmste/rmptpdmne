// LILY SOKID – andmemudel
//
// Reeglid äritabelitele (lisanduvad faasist 1):
// - väljad id (cuid), companyId, createdAt, updatedAt, createdById
// - @@unique([companyId, id]) ja seosed teiste äritabelitega komposiitvõtmega (companyId, xxxId)
// - summad Decimal @db.Decimal(18, 2), kogused Decimal @db.Decimal(18, 4)
// - kuupäevad ilma kellaajata @db.Date

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrgRole {
  ADMIN
  MEMBER
}

enum CompanyRole {
  OWNER
  ACCOUNTANT
  EDITOR
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// Raamatupidamisbüroo või ettevõtte enda konto, mis omab ettevõtteid.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   OrganizationMember[]
  companies Company[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  /// ADMIN võib organisatsiooni alla ettevõtteid lisada.
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  /// null = kasutaja logib sisse ainult magic lingiga.
  passwordHash  String?
  locale        String    @default("et")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  orgMemberships OrganizationMember[]
  memberships    Membership[]
}

/// Auth.js: välised identiteedid (OAuth/OIDC, hiljem Smart-ID).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Auth.js: magic linkide tokenid.
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id                    String      @id @default(cuid())
  organizationId        String
  name                  String
  /// Registrikood
  regCode               String?
  /// KMKR number
  vatNumber             String?
  countryCode           String      @default("EE") @db.Char(2)
  baseCurrency          String      @default("EUR") @db.Char(3)
  /// Dokumentide (arved jm) vaikimisi keel
  documentLocale        String      @default("et")
  /// Ettevõtte liik – määrab vaikimisi kontoplaani ja aruannete skeemi
  type                  CompanyType @default(BUSINESS)
  /// Kasumiaruande skeem (1 = kulude liigi järgi, 2 = funktsiooni järgi)
  incomeStatementScheme Int         @default(1)
  /// Arvestuse algus LILY SOKID-is; algsaldod on sellele eelneva päeva seisuga
  accountingStartDate   DateTime?   @db.Date
  /// Sellest kuupäevast varasemaid (kaasa arvatud) kandeid ei saa lisada ega muuta
  lockedUntil           DateTime?   @db.Date
  addressStreet         String?
  addressCity           String?
  addressCounty         String?
  addressPostalCode     String?
  phone                 String?
  email                 String?
  website               String?
  /// Arve seadistus: vaikimisi maksetähtaeg päevades
  paymentTermDays       Int         @default(14)
  /// Viivis protsentides päevas
  lateInterestPct       Decimal     @default(0.05) @db.Decimal(6, 3)
  /// Pangarekvisiidid arvel (kuni pangakontod lisanduvad faasis 5)
  invoiceBankDetails    String?
  /// Arve jaluse tekst
  invoiceFooter         String?
  /// Arve vaikimisi märkus (nt „Täname koostöö eest!“)
  invoiceNote           String?
  /// Arve aktsentvärv (hex)
  invoiceAccent         String      @default("#0f5c55")
  isDemo                Boolean     @default(false)
  archivedAt            DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  createdById           String?

  organization     Organization      @relation(fields: [organizationId], references: [id])
  memberships      Membership[]
  invitations      Invitation[]
  notifications    Notification[]
  glAccounts       GlAccount[]
  vatRates         VatRate[]
  fiscalYears      FiscalYear[]
  numberSeries     NumberSeries[]
  currencies       CompanyCurrency[]
  departments      Department[]
  dimensions       Dimension[]
  journalEntries   JournalEntry[]
  journalTemplates JournalTemplate[]
  customers        Customer[]
  customerGroups   CustomerGroup[]
  items            Item[]
  itemGroups       ItemGroup[]
  salesInvoices    SalesInvoice[]
  quotes           Quote[]
  emailLogs        EmailLog[]
  suppliers        Supplier[]
  supplierGroups   SupplierGroup[]
  employees        Employee[]
  purchaseInvoices PurchaseInvoice[]
  purchaseOrders   PurchaseOrder[]
  expenseReports   ExpenseReport[]
  attachments      Attachment[]
  bankAccounts     BankAccount[]
  payments         Payment[]
  bankStatements   BankStatement[]
  paymentOrders    PaymentOrder[]

  @@index([organizationId])
  @@index([regCode])
}

enum CompanyType {
  /// Äriühing (OÜ, AS jt)
  BUSINESS
  /// Füüsilisest isikust ettevõtja
  SOLE_PROPRIETOR
  /// MTÜ, SA
  NONPROFIT
}

// ---------------------------------------------------------------------------
// Faas 1: raamatupidamise seadistused
// ---------------------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountKind {
  /// Kontole saab kandeid teha
  DETAIL
  /// Koondkonto: summeerib koodi algusega sobivad detailkontod, kandeid ei tehta
  SUMMARY
}

/// Kuidas konto tehingud käibedeklaratsioonis kajastuvad
enum VatTurnover {
  NONE
  SALES
  PURCHASE
}

/// Süsteemne roll – programm kasutab neid kontosid automaatsetes kannetes
enum AccountRole {
  RECEIVABLES
  CUSTOMER_PREPAYMENTS
  PAYABLES
  SUPPLIER_PREPAYMENTS
  EMPLOYEE_PAYABLES
  EMPLOYEE_RECEIVABLES
  INVENTORY
  COST_OF_GOODS_SOLD
  DEFAULT_SALES
  DEFAULT_PURCHASE
  ROUNDING_INCOME
  ROUNDING_EXPENSE
  FX_GAIN_LOSS
  BANK_FEES
  VAT_PAYABLE
  RETAINED_EARNINGS
  CURRENT_YEAR_PROFIT
}

/// Pearaamatu konto (nimi GlAccount, sest Auth.js kasutab mudelit Account).
model GlAccount {
  id                   String       @id @default(cuid())
  companyId            String
  /// 1… varad, 2… kohustised ja omakapital, 3… tulud, 4… kulud
  code                 String
  name                 String
  nameEn               String?
  type                 AccountType
  kind                 AccountKind  @default(DETAIL)
  /// Bilansi või kasumiaruande rea kood (src/lib/accounting/report-lines.ts)
  reportLine           String?
  /// Vaikimisi käibemaks selle konto kasutamisel
  defaultVatRateId     String?
  vatTurnover          VatTurnover  @default(NONE)
  /// Makseviisina kasutatav konto (pank, kassa)
  isPaymentMethod      Boolean      @default(false)
  /// Osakond kohustuslik
  requiresDepartment   Boolean      @default(false)
  /// Dimensioonid, mille väärtus on kohustuslik (Dimension.id)
  requiredDimensionIds String[]     @default([])
  showOnDashboard      Boolean      @default(false)
  /// Kasumiaruande skeem 2 (kulude funktsiooni järgi); null = vaikimisi rea järgi
  costFunction         CostFunction?
  role                 AccountRole?
  active               Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  createdById          String?

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultVatRate       VatRate?              @relation("AccountDefaultVat", fields: [defaultVatRateId], references: [id], onDelete: SetNull)
  journalLines         JournalLine[]
  salesVatRates        VatRate[]             @relation("VatSalesAccount")
  purchaseVatRates     VatRate[]             @relation("VatPurchaseAccount")
  journalTemplateLines JournalTemplateLine[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@unique([companyId, role])
  @@index([companyId, type])
}

/// Kulu funktsioon kasumiaruande skeemi 2 jaoks
enum CostFunction {
  COST_OF_SALES
  DISTRIBUTION
  ADMIN
}

/// Käibemaksu liik – määrab, kuidas tehing KMD-l kajastub
enum VatKind {
  /// Maksustatav käive määraga (24%, 13%, 9% …)
  TAXABLE
  /// 0% eksport
  ZERO_EXPORT
  /// 0% kauba ühendusesisene käive
  ZERO_EU_GOODS
  /// Teenused teise liikmesriigi maksukohustuslasele
  EU_SERVICES
  /// Maksuvaba käive (KMS § 16)
  EXEMPT
  /// Siseriiklik pöördmaksustamine (KMS § 41¹)
  REVERSE_CHARGE
  /// Ei ole käive / ei kajastu KMD-l
  NOT_TAXABLE
  /// Kasuminormi (marginaali) erikord: kasutatud kaup (KMS § 41), reisiteenus (KMS § 40).
  /// Arvel käibemaksu ei näidata, maks arvutatakse juurdehindlusest.
  MARGIN
}

/// Käibemaks. Määr sõltub kuupäevast (VatRatePeriod), mitte ei ole koodi sisse kirjutatud.
model VatRate {
  id                String   @id @default(cuid())
  companyId         String
  code              String
  name              String
  nameEn            String?
  kind              VatKind  @default(TAXABLE)
  /// Mahaarvatav osa sisendkäibemaksust protsentides (sõiduauto 50%, proportsionaalne)
  deductiblePct     Decimal  @default(100) @db.Decimal(5, 2)
  /// Viide arvel (nt KMS § 15 lg 3 p 1)
  invoiceNote       String?
  /// Arvestatud (müügi) käibemaksu konto
  salesAccountId    String?
  /// Sisendkäibemaksu konto
  purchaseAccountId String?
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?

  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesAccount       GlAccount?      @relation("VatSalesAccount", fields: [salesAccountId], references: [id], onDelete: SetNull)
  purchaseAccount    GlAccount?      @relation("VatPurchaseAccount", fields: [purchaseAccountId], references: [id], onDelete: SetNull)
  periods            VatRatePeriod[]
  defaultForAccounts GlAccount[]     @relation("AccountDefaultVat")
  journalLines       JournalLine[]

  @@unique([companyId, id])
  @@unique([companyId, code])
}

/// Käibemaksumäär kehtivusvahemikuga.
model VatRatePeriod {
  id        String    @id @default(cuid())
  companyId String
  vatRateId String
  rate      Decimal   @db.Decimal(5, 2)
  validFrom DateTime  @db.Date
  /// null = kehtib edasi
  validTo   DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vatRate VatRate @relation(fields: [companyId, vatRateId], references: [companyId, id], onDelete: Cascade)

  @@index([companyId, vatRateId, validFrom])
}

model FiscalYear {
  id          String    @id @default(cuid())
  companyId   String
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  /// Suletud aastasse ei saa kandeid lisada ega muuta
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, id])
  @@unique([companyId, startDate])
}

enum DocumentType {
  SALES_INVOICE
  CREDIT_INVOICE
  PREPAYMENT_INVOICE
  QUOTE
  PURCHASE_ORDER
  JOURNAL_ENTRY
  PAYMENT
  INTEREST_INVOICE
  /// Ostuarve sisemine registreerimisnumber
  PURCHASE_INVOICE
  EXPENSE_REPORT
}

model NumberSeries {
  id           String       @id @default(cuid())
  companyId    String
  documentType DocumentType
  prefix       String       @default("")
  suffix       String       @default("")
  /// Kas loendur algab igal kalendriaastal uuesti (number kujul aasta/number)
  yearBased    Boolean      @default(false)
  /// Mitmekohaliseks täiendatakse nullidega (0 = ei täiendata)
  padding      Int          @default(0)
  /// Järgmine number, kui seeria ei ole aastapõhine
  nextNumber   Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdById  String?

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  counters NumberSeriesCounter[]

  @@unique([companyId, id])
  @@unique([companyId, documentType])
}

/// Aastapõhise seeria loendur.
model NumberSeriesCounter {
  id         String @id @default(cuid())
  companyId  String
  seriesId   String
  year       Int
  nextNumber Int    @default(1)

  series NumberSeries @relation(fields: [companyId, seriesId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, seriesId, year])
}

/// Ettevõttes kasutusel olevad valuutad (EUR on alati olemas).
model CompanyCurrency {
  id        String   @id @default(cuid())
  companyId String
  code      String   @db.Char(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
}

/// Valuutakursid (1 EUR = rate valuutat). Üldine, mitte ettevõttepõhine.
model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String   @db.Char(3)
  date      DateTime @db.Date
  rate      Decimal  @db.Decimal(18, 6)
  /// "ECB" või "MANUAL"
  source    String   @default("ECB")
  createdAt DateTime @default(now())

  @@unique([currency, date])
}

/// Osakond (tulude-kulude ja arvete jaotus, eraldi numeratsioon).
model Department {
  id          String   @id @default(cuid())
  companyId   String
  code        String
  name        String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]

  @@unique([companyId, id])
  @@unique([companyId, code])
}

enum DimensionKind {
  DETAIL
  SUMMARY
}

/// Vaba dimensioon (nt projekt, kulukoht).
model Dimension {
  id            String        @id @default(cuid())
  companyId     String
  name          String
  kind          DimensionKind @default(DETAIL)
  /// Üldine dimensioon, mille alla see detailne kuulub
  parentId      String?
  /// Summa deebetis positiivne (kulude jälgimiseks); muidu kreeditis (tulud)
  debitPositive Boolean       @default(false)
  active        Boolean       @default(true)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdById   String?

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Dimension?       @relation("DimensionParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Dimension[]      @relation("DimensionParent")
  values   DimensionValue[]

  @@unique([companyId, id])
  @@unique([companyId, name])
}

model DimensionValue {
  id          String    @id @default(cuid())
  companyId   String
  dimensionId String
  code        String
  name        String
  /// Pärast seda kuupäeva väärtust tehingutes ei pakuta
  endDate     DateTime? @db.Date
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  dimension Dimension              @relation(fields: [companyId, dimensionId], references: [companyId, id], onDelete: Cascade)
  lines     JournalLineDimension[]

  @@unique([companyId, id])
  @@unique([companyId, dimensionId, code])
}

// ---------------------------------------------------------------------------
// Pearaamat (algsaldod faasis 1, käsitsi kanded faasis 2)
// ---------------------------------------------------------------------------

enum JournalSource {
  OPENING_BALANCE
  MANUAL
  SALES_INVOICE
  PURCHASE_INVOICE
  EXPENSE_REPORT
  PAYMENT
  INVENTORY
  DEPRECIATION
  VAT_CLOSING
  YEAR_END
}

enum JournalStatus {
  /// Mustand: ei mõjuta pearaamatut, võib vabalt muuta
  DRAFT
  /// Postitatud: muuta ei saa, parandus käib stornoga
  POSTED
}

model JournalEntry {
  id           String        @id @default(cuid())
  companyId    String
  /// Kande number seeria sees (nt PR-15); mustandil puudub
  number       String?
  status       JournalStatus @default(POSTED)
  postedAt     DateTime?
  postedById   String?
  date         DateTime      @db.Date
  source       JournalSource
  /// Lähtedokumendi id (arve, makse …)
  sourceId     String?
  description  String?
  /// Storno korral viide algsele kandele
  reversalOfId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  String?

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reversalOf JournalEntry?  @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy JournalEntry[] @relation("Reversal")
  lines      JournalLine[]

  @@unique([companyId, id])
  @@index([companyId, date])
  @@index([companyId, status, date])
  @@index([companyId, source, sourceId])
}

model JournalLine {
  id           String   @id @default(cuid())
  companyId    String
  entryId      String
  accountId    String
  debit        Decimal  @default(0) @db.Decimal(18, 2)
  credit       Decimal  @default(0) @db.Decimal(18, 2)
  description  String?
  departmentId String?
  vatRateId    String?
  /// Käibemaksu summa, mille alusel rida KMD-l kajastub
  vatAmount    Decimal? @db.Decimal(18, 2)
  sortOrder    Int      @default(0)

  entry      JournalEntry           @relation(fields: [companyId, entryId], references: [companyId, id], onDelete: Cascade)
  account    GlAccount              @relation(fields: [companyId, accountId], references: [companyId, id], onDelete: Restrict)
  department Department?            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  vatRate    VatRate?               @relation(fields: [vatRateId], references: [id], onDelete: Restrict)
  dimensions JournalLineDimension[]

  @@unique([companyId, id])
  @@index([companyId, accountId])
  @@index([companyId, entryId])
}

/// Kanderea seos dimensiooni väärtusega (igast dimensioonist üks väärtus).
model JournalLineDimension {
  id               String @id @default(cuid())
  companyId        String
  lineId           String
  dimensionValueId String

  line  JournalLine    @relation(fields: [companyId, lineId], references: [companyId, id], onDelete: Cascade)
  value DimensionValue @relation(fields: [companyId, dimensionValueId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, lineId, dimensionValueId])
}

/// Kasutaja ligipääs ettevõttele.
model Membership {
  id             String      @id @default(cuid())
  userId         String
  companyId      String
  role           CompanyRole
  /// Mooduli kaupa erandid rolli vaikeõigustest, nt { "sales": "edit", "settings": "none" }
  permissions    Json?
  /// Ettevõtte vahetaja „viimati kasutatud“ järjestus
  lastAccessedAt DateTime?
  /// Töölaua vidinate järjestus ja peidetud vidinad: { order: string[], hidden: string[] }
  dashboard      Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId, lastAccessedAt(sort: Desc)])
}

model Invitation {
  id          String           @id @default(cuid())
  companyId   String
  email       String
  role        CompanyRole
  permissions Json?
  /// SHA-256 räsi; token ise läheb ainult e-kirja.
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([email])
}

/// Ettevõtte teated töölaual (süsteemi teated, tähtajad).
model Notification {
  id          String    @id @default(cuid())
  companyId   String
  /// null = nähtav kõigile ettevõtte kasutajatele
  userId      String?
  /// "system" | "deadline" | ...
  kind        String
  title       String
  body        String?
  href        String?
  dueDate     DateTime? @db.Date
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, id])
  @@index([companyId, createdAt(sort: Desc)])
}

/// Muutmatu logi: rakendus teeb ainult INSERT-e.
model AuditLog {
  id         String   @id @default(cuid())
  /// null = kasutaja või süsteemi tasemel sündmus
  companyId  String?
  userId     String?
  /// nt "company.update", "membership.invite"
  action     String
  entityType String
  entityId   String?
  /// { before, after } – ainult muutunud väljad
  diff       Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

model RateLimit {
  /// nt "login:ip:1.2.3.4"
  key     String   @id
  count   Int
  resetAt DateTime
}

/// Kandemall: korduva kande põhi (kontod, pooled, soovi korral summad).
model JournalTemplate {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  company Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   JournalTemplateLine[]

  @@unique([companyId, id])
  @@unique([companyId, name])
}

model JournalTemplateLine {
  id          String   @id @default(cuid())
  companyId   String
  templateId  String
  accountId   String
  debit       Decimal? @db.Decimal(18, 2)
  credit      Decimal? @db.Decimal(18, 2)
  description String?
  sortOrder   Int      @default(0)

  template JournalTemplate @relation(fields: [companyId, templateId], references: [companyId, id], onDelete: Cascade)
  account  GlAccount       @relation(fields: [companyId, accountId], references: [companyId, id], onDelete: Cascade)

  @@index([companyId, templateId])
}

// ---------------------------------------------------------------------------
// Faas 3: müük
// ---------------------------------------------------------------------------

model CustomerGroup {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@unique([companyId, id])
  @@unique([companyId, name])
}

model Customer {
  id                String   @id @default(cuid())
  companyId         String
  name              String
  /// Eraisik (registrikoodi asemel isikukood või puudub)
  isPerson          Boolean  @default(false)
  regCode           String?
  vatNumber         String?
  countryCode       String   @default("EE") @db.Char(2)
  addressStreet     String?
  addressCity       String?
  addressPostalCode String?
  addressCounty     String?
  email             String?
  /// Arve koopia saajad (komaga eraldatud)
  emailCc           String?
  phone             String?
  contactPerson     String?
  /// null = ettevõtte vaikimisi maksetähtaeg
  paymentTermDays   Int?
  /// Viivis % päevas; null = ettevõtte vaikimisi
  lateInterestPct   Decimal? @db.Decimal(6, 3)
  /// Arvete keel
  locale            String   @default("et")
  currency          String   @default("EUR") @db.Char(3)
  /// Püsiviitenumber (kui klient maksab alati sama viitega); muidu arve numbrist
  referenceNumber   String?
  groupId           String?
  /// Vaikimisi käibemaks kliendi arvetel (nt EL teenused)
  defaultVatRateId  String?
  notes             String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group    CustomerGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  invoices SalesInvoice[]
  quotes   Quote[]

  @@unique([companyId, id])
  @@index([companyId, name])
  @@index([companyId, regCode])
}

model ItemGroup {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   Item[]

  @@unique([companyId, id])
  @@unique([companyId, name])
}

enum ItemType {
  GOODS
  SERVICE
}

/// Artikkel (kaup või teenus) – ühine müügi ja ostuga.
model Item {
  id                String   @id @default(cuid())
  companyId         String
  code              String
  name              String
  nameEn            String?
  type              ItemType @default(SERVICE)
  unit              String?
  /// Müügihind ilma käibemaksuta
  salePrice         Decimal? @db.Decimal(18, 4)
  /// Viimane ostuhind (kasuminormi erikorra ja hiljem lao jaoks)
  purchasePrice     Decimal? @db.Decimal(18, 4)
  vatRateId         String?
  salesAccountId    String?
  purchaseAccountId String?
  groupId           String?
  /// Kasutatav müügis / ostus
  forSales          Boolean  @default(true)
  forPurchases      Boolean  @default(true)
  description       String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group   ItemGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([companyId, id])
  @@unique([companyId, code])
}

enum SalesInvoiceType {
  INVOICE
  CREDIT
  PREPAYMENT
}

enum DocumentStatus {
  /// Mustand: vabalt muudetav, pearaamatus ei kajastu
  DRAFT
  /// Kinnitatud: kanne tehtud, muuta ei saa (parandus kreeditarvega)
  CONFIRMED
}

model SalesInvoice {
  id                String           @id @default(cuid())
  companyId         String
  type              SalesInvoiceType @default(INVOICE)
  status            DocumentStatus   @default(DRAFT)
  /// Number antakse kinnitamisel
  number            String?
  customerId        String
  /// Kliendi andmed arve koostamise hetkel (arvel ei muutu, kui klient hiljem muutub)
  customerName      String
  customerRegCode   String?
  customerVatNumber String?
  customerAddress   String?
  customerEmail     String?
  date              DateTime         @db.Date
  dueDate           DateTime         @db.Date
  /// Kauba/teenuse üleandmise kuupäev, kui erineb
  deliveryDate      DateTime?        @db.Date
  referenceNumber   String?
  currency          String           @default("EUR") @db.Char(3)
  /// 1 EUR = rate valuutat
  currencyRate      Decimal          @default(1) @db.Decimal(18, 6)
  pricesIncludeVat  Boolean          @default(false)
  locale            String           @default("et")
  yourReference     String?
  notes             String?
  lateInterestPct   Decimal?         @db.Decimal(6, 3)
  /// Kreeditarve korral algne arve
  creditOfId        String?
  /// Tax-free korrigeerimine (KMS § 15 lg 3 p 2): müük reisijale muudetakse 0% ekspordiks
  taxFree           Boolean          @default(false)
  /// Pakkumine, millest arve tehti
  quoteId           String?
  netTotal          Decimal          @default(0) @db.Decimal(18, 2)
  vatTotal          Decimal          @default(0) @db.Decimal(18, 2)
  total             Decimal          @default(0) @db.Decimal(18, 2)
  /// Kogusumma eurodes (pearaamatu summa)
  totalBase         Decimal          @default(0) @db.Decimal(18, 2)
  /// Tasutud summa arve valuutas (kinnitatud maksete sidumistest)
  paidTotal         Decimal          @default(0) @db.Decimal(18, 2)
  journalEntryId    String?
  confirmedAt       DateTime?
  confirmedById     String?
  sentAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdById       String?

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer           @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict)
  creditOf SalesInvoice?      @relation("CreditOf", fields: [creditOfId], references: [id], onDelete: Restrict)
  credits  SalesInvoice[]     @relation("CreditOf")
  lines    SalesInvoiceLine[]

  @@unique([companyId, id])
  @@index([companyId, date])
  @@index([companyId, status, date])
  @@index([companyId, customerId])
  @@index([companyId, number])
}

model SalesInvoiceLine {
  id                  String   @id @default(cuid())
  companyId           String
  invoiceId           String
  itemId              String?
  code                String?
  description         String
  quantity            Decimal  @db.Decimal(18, 4)
  unit                String?
  unitPrice           Decimal  @db.Decimal(18, 4)
  discountPct         Decimal  @default(0) @db.Decimal(5, 2)
  vatRateId           String?
  /// Rakendatud määr (kreeditarvel algse arve määr)
  vatPct              Decimal  @default(0) @db.Decimal(5, 2)
  accountId           String
  departmentId        String?
  dimensionValueIds   String[] @default([])
  /// Kasuminormi erikorra korral soetusmaksumus ühiku kohta
  unitCost            Decimal? @db.Decimal(18, 4)
  /// Lõpparvel tasaarveldatud ettemaksuarve
  prepaymentInvoiceId String?
  netAmount           Decimal  @default(0) @db.Decimal(18, 2)
  vatAmount           Decimal  @default(0) @db.Decimal(18, 2)
  /// Kasuminormi erikorra käibemaks (arvel ei näidata)
  marginVatAmount     Decimal  @default(0) @db.Decimal(18, 2)
  sortOrder           Int      @default(0)

  invoice SalesInvoice @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, id])
  @@index([companyId, invoiceId])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  INVOICED
}

model Quote {
  id                String      @id @default(cuid())
  companyId         String
  status            QuoteStatus @default(DRAFT)
  number            String
  customerId        String
  customerName      String
  customerRegCode   String?
  customerVatNumber String?
  customerAddress   String?
  customerEmail     String?
  date              DateTime    @db.Date
  validUntil        DateTime?   @db.Date
  currency          String      @default("EUR") @db.Char(3)
  pricesIncludeVat  Boolean     @default(false)
  locale            String      @default("et")
  yourReference     String?
  notes             String?
  netTotal          Decimal     @default(0) @db.Decimal(18, 2)
  vatTotal          Decimal     @default(0) @db.Decimal(18, 2)
  total             Decimal     @default(0) @db.Decimal(18, 2)
  invoiceId         String?
  sentAt            DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  createdById       String?

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict)
  lines    QuoteLine[]

  @@unique([companyId, id])
  @@unique([companyId, number])
  @@index([companyId, date])
}

model QuoteLine {
  id                String   @id @default(cuid())
  companyId         String
  quoteId           String
  itemId            String?
  code              String?
  description       String
  quantity          Decimal  @db.Decimal(18, 4)
  unit              String?
  unitPrice         Decimal  @db.Decimal(18, 4)
  discountPct       Decimal  @default(0) @db.Decimal(5, 2)
  vatRateId         String?
  vatPct            Decimal  @default(0) @db.Decimal(5, 2)
  accountId         String?
  departmentId      String?
  dimensionValueIds String[] @default([])
  unitCost          Decimal? @db.Decimal(18, 4)
  netAmount         Decimal  @default(0) @db.Decimal(18, 2)
  vatAmount         Decimal  @default(0) @db.Decimal(18, 2)
  sortOrder         Int      @default(0)

  quote Quote @relation(fields: [companyId, quoteId], references: [companyId, id], onDelete: Cascade)

  @@index([companyId, quoteId])
}

enum EmailStatus {
  SENT
  FAILED
}

/// Dokumentide saatmise logi (arved, pakkumised, hiljem meeldetuletused ja saldoteatised).
model EmailLog {
  id           String      @id @default(cuid())
  companyId    String
  /// "SalesInvoice" | "Quote" | ...
  documentType String
  documentId   String
  to           String
  cc           String?
  subject      String
  status       EmailStatus
  error        String?
  providerId   String?
  sentById     String?
  createdAt    DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, documentType, documentId])
  @@index([companyId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Faas 4: ost
// ---------------------------------------------------------------------------

model SupplierGroup {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  suppliers Supplier[]

  @@unique([companyId, id])
  @@unique([companyId, name])
}

model Supplier {
  id                String   @id @default(cuid())
  companyId         String
  name              String
  isPerson          Boolean  @default(false)
  regCode           String?
  vatNumber         String?
  countryCode       String   @default("EE") @db.Char(2)
  addressStreet     String?
  addressCity       String?
  addressPostalCode String?
  addressCounty     String?
  email             String?
  phone             String?
  contactPerson     String?
  /// Arvelduskonto (IBAN) maksekorralduste jaoks
  bankAccount       String?
  /// Tarnija püsiviitenumber maksetel
  referenceNumber   String?
  paymentTermDays   Int?
  currency          String   @default("EUR") @db.Char(3)
  groupId           String?
  /// Vaikimisi kulukonto ostuarve ridadel
  defaultAccountId  String?
  defaultVatRateId  String?
  notes             String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdById       String?

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group    SupplierGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  invoices PurchaseInvoice[]
  orders   PurchaseOrder[]

  @@unique([companyId, id])
  @@index([companyId, name])
  @@index([companyId, regCode])
}

/// Aruandev isik (töötaja, kes esitab kuluaruandeid).
model Employee {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  personalCode String?
  email        String?
  bankAccount  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdById  String?

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reports ExpenseReport[]

  @@unique([companyId, id])
  @@unique([companyId, name])
}

enum PurchaseSource {
  /// Sisestatud käsitsi
  MANUAL
  /// Üles laaditud fail (kinnitamata ostuarvete kaust)
  UPLOAD
  /// Ostutellimusest
  ORDER
}

model PurchaseInvoice {
  id                String         @id @default(cuid())
  companyId         String
  status            DocumentStatus @default(DRAFT)
  /// Kreeditarve (summad negatiivsed)
  isCredit          Boolean        @default(false)
  source            PurchaseSource @default(MANUAL)
  /// Sisemine registreerimisnumber, antakse kinnitamisel
  number            String?
  /// Üleslaaditud arvel võib tarnija veel puududa
  supplierId        String?
  supplierName      String         @default("")
  supplierRegCode   String?
  supplierVatNumber String?
  /// Tarnija arve number
  invoiceNumber     String?
  date              DateTime       @db.Date
  dueDate           DateTime       @db.Date
  referenceNumber   String?
  /// Tarnija IBAN arve koostamise hetkel (maksekorralduse jaoks)
  bankAccount       String?
  currency          String         @default("EUR") @db.Char(3)
  currencyRate      Decimal        @default(1) @db.Decimal(18, 6)
  pricesIncludeVat  Boolean        @default(false)
  notes             String?
  creditOfId        String?
  purchaseOrderId   String?
  netTotal          Decimal        @default(0) @db.Decimal(18, 2)
  vatTotal          Decimal        @default(0) @db.Decimal(18, 2)
  total             Decimal        @default(0) @db.Decimal(18, 2)
  totalBase         Decimal        @default(0) @db.Decimal(18, 2)
  paidTotal         Decimal        @default(0) @db.Decimal(18, 2)
  journalEntryId    String?
  confirmedAt       DateTime?
  confirmedById     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  createdById       String?

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  creditOf PurchaseInvoice?      @relation("PurchaseCreditOf", fields: [creditOfId], references: [id], onDelete: Restrict)
  credits  PurchaseInvoice[]     @relation("PurchaseCreditOf")
  lines    PurchaseInvoiceLine[]

  @@unique([companyId, id])
  @@index([companyId, date])
  @@index([companyId, status, date])
  @@index([companyId, supplierId])
}

model PurchaseInvoiceLine {
  id                String   @id @default(cuid())
  companyId         String
  invoiceId         String
  itemId            String?
  code              String?
  description       String
  quantity          Decimal  @db.Decimal(18, 4)
  unit              String?
  unitPrice         Decimal  @db.Decimal(18, 4)
  discountPct       Decimal  @default(0) @db.Decimal(5, 2)
  vatRateId         String?
  vatPct            Decimal  @default(0) @db.Decimal(5, 2)
  accountId         String
  departmentId      String?
  dimensionValueIds String[] @default([])
  netAmount         Decimal  @default(0) @db.Decimal(18, 2)
  /// Tarnija arvel olev käibemaks
  vatAmount         Decimal  @default(0) @db.Decimal(18, 2)
  /// Pöördmaksustatav käibemaks (ostja arvestab ise)
  reverseVatAmount  Decimal  @default(0) @db.Decimal(18, 2)
  /// Mahaarvatav sisendkäibemaks
  deductibleVat     Decimal  @default(0) @db.Decimal(18, 2)
  sortOrder         Int      @default(0)

  invoice PurchaseInvoice @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, id])
  @@index([companyId, invoiceId])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  INVOICED
  CANCELLED
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  companyId        String
  status           PurchaseOrderStatus @default(DRAFT)
  number           String
  supplierId       String
  supplierName     String
  date             DateTime            @db.Date
  expectedDate     DateTime?           @db.Date
  currency         String              @default("EUR") @db.Char(3)
  pricesIncludeVat Boolean             @default(false)
  notes            String?
  netTotal         Decimal             @default(0) @db.Decimal(18, 2)
  vatTotal         Decimal             @default(0) @db.Decimal(18, 2)
  total            Decimal             @default(0) @db.Decimal(18, 2)
  invoiceId        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  createdById      String?

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [companyId, supplierId], references: [companyId, id], onDelete: Restrict)
  lines    PurchaseOrderLine[]

  @@unique([companyId, id])
  @@unique([companyId, number])
  @@index([companyId, date])
}

model PurchaseOrderLine {
  id                String   @id @default(cuid())
  companyId         String
  orderId           String
  itemId            String?
  code              String?
  description       String
  quantity          Decimal  @db.Decimal(18, 4)
  unit              String?
  unitPrice         Decimal  @db.Decimal(18, 4)
  discountPct       Decimal  @default(0) @db.Decimal(5, 2)
  vatRateId         String?
  vatPct            Decimal  @default(0) @db.Decimal(5, 2)
  accountId         String?
  departmentId      String?
  dimensionValueIds String[] @default([])
  netAmount         Decimal  @default(0) @db.Decimal(18, 2)
  vatAmount         Decimal  @default(0) @db.Decimal(18, 2)
  sortOrder         Int      @default(0)

  order PurchaseOrder @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Cascade)

  @@index([companyId, orderId])
}

/// Aruandva isiku kuluaruanne: kuludokumendid (tšekid), mille töötaja tasus oma rahaga.
model ExpenseReport {
  id             String         @id @default(cuid())
  companyId      String
  status         DocumentStatus @default(DRAFT)
  number         String?
  employeeId     String
  employeeName   String
  date           DateTime       @db.Date
  description    String?
  netTotal       Decimal        @default(0) @db.Decimal(18, 2)
  vatTotal       Decimal        @default(0) @db.Decimal(18, 2)
  total          Decimal        @default(0) @db.Decimal(18, 2)
  paidTotal      Decimal        @default(0) @db.Decimal(18, 2)
  journalEntryId String?
  confirmedAt    DateTime?
  confirmedById  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee            @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  lines    ExpenseReportLine[]

  @@unique([companyId, id])
  @@index([companyId, date])
}

model ExpenseReportLine {
  id                String   @id @default(cuid())
  companyId         String
  reportId          String
  date              DateTime @db.Date
  /// Kuludokumendi väljastaja (pood, hotell …)
  vendor            String?
  documentNumber    String?
  description       String
  accountId         String
  vatRateId         String?
  vatPct            Decimal  @default(0) @db.Decimal(5, 2)
  /// Summa koos käibemaksuga (nagu tšekil)
  grossAmount       Decimal  @db.Decimal(18, 2)
  netAmount         Decimal  @default(0) @db.Decimal(18, 2)
  vatAmount         Decimal  @default(0) @db.Decimal(18, 2)
  deductibleVat     Decimal  @default(0) @db.Decimal(18, 2)
  departmentId      String?
  dimensionValueIds String[] @default([])
  sortOrder         Int      @default(0)

  report ExpenseReport @relation(fields: [companyId, reportId], references: [companyId, id], onDelete: Cascade)

  @@index([companyId, reportId])
}

enum AttachmentStorage {
  /// Vercel Blob (tootmine)
  BLOB
  /// Andmebaasis (arendus ja testid, kui Blob pole seadistatud)
  DATABASE
}

/// Dokumendi manus (ostuarve skaneering, tšekk, leping …).
model Attachment {
  id           String            @id @default(cuid())
  companyId    String
  /// "PurchaseInvoice" | "ExpenseReport" | "SalesInvoice" | "JournalEntry" | ...
  documentType String
  documentId   String
  fileName     String
  contentType  String
  size         Int
  storage      AttachmentStorage
  url          String?
  data         Bytes?
  uploadedById String?
  createdAt    DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, id])
  @@index([companyId, documentType, documentId])
}

// ---------------------------------------------------------------------------
// Faas 5: maksed
// ---------------------------------------------------------------------------

enum MoneyAccountKind {
  BANK
  CASH
}

/// Pangakonto või kassa; seotud pearaamatu kontoga.
model BankAccount {
  id            String           @id @default(cuid())
  companyId     String
  kind          MoneyAccountKind @default(BANK)
  name          String
  iban          String?
  bic           String?
  currency      String           @default("EUR") @db.Char(3)
  /// Pearaamatu konto (nt 1020 Pangakonto, 1000 Kassa)
  accountId     String
  /// Kuvatakse arvetel pangarekvisiitidena
  showOnInvoice Boolean          @default(true)
  active        Boolean          @default(true)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdById   String?

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payments   Payment[]
  statements BankStatement[]

  @@unique([companyId, id])
  @@unique([companyId, name])
}

enum PaymentDirection {
  /// Laekumine (klient maksab)
  IN
  /// Väljamakse (tarnijale, töötajale, maksud)
  OUT
  /// Tasaarveldus või mahakandmine ilma rahaliikumiseta
  NETTING
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  EMPLOYEE
  OTHER
}

model Payment {
  id              String           @id @default(cuid())
  companyId       String
  status          DocumentStatus   @default(DRAFT)
  number          String?
  direction       PaymentDirection
  /// Tasaarveldusel puudub
  bankAccountId   String?
  date            DateTime         @db.Date
  /// Summa maksekonto valuutas (alati positiivne; tasaarveldusel 0)
  amount          Decimal          @default(0) @db.Decimal(18, 2)
  currency        String           @default("EUR") @db.Char(3)
  currencyRate    Decimal          @default(1) @db.Decimal(18, 6)
  amountBase      Decimal          @default(0) @db.Decimal(18, 2)
  partyType       PartyType        @default(OTHER)
  customerId      String?
  supplierId      String?
  employeeId      String?
  partyName       String           @default("")
  partyIban       String?
  referenceNumber String?
  description     String?
  /// Pangaväljavõtte rida, millega makse on kooskõlastatud
  statementLineId String?
  paymentOrderId  String?
  journalEntryId  String?
  confirmedAt     DateTime?
  confirmedById   String?
  /// Tühistatud makse (storno): sidumised ei loe, kanne on tagasi pööratud
  cancelledAt     DateTime?
  cancelEntryId   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount BankAccount?        @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@unique([companyId, id])
  @@index([companyId, date])
  @@index([companyId, status, date])
  @@index([companyId, bankAccountId, date])
}

enum AllocationType {
  SALES_INVOICE
  PURCHASE_INVOICE
  EXPENSE_REPORT
  /// Ettemaks ilma arveta (kliendi ettemaks / ettemaks tarnijale)
  PREPAYMENT
  /// Otse pearaamatu kontole (teenustasu, maks, laen, mahakandmine …)
  ACCOUNT
}

model PaymentAllocation {
  id                String         @id @default(cuid())
  companyId         String
  paymentId         String
  type              AllocationType
  salesInvoiceId    String?
  purchaseInvoiceId String?
  expenseReportId   String?
  accountId         String?
  /// Summa makse valuutas. Tasaarveldusel märgiga: + vähendab nõuet/kohustust arve poolel.
  amount            Decimal        @db.Decimal(18, 2)
  description       String?
  sortOrder         Int            @default(0)

  payment Payment @relation(fields: [companyId, paymentId], references: [companyId, id], onDelete: Cascade)

  @@index([companyId, paymentId])
  @@index([companyId, salesInvoiceId])
  @@index([companyId, purchaseInvoiceId])
  @@index([companyId, expenseReportId])
}

enum StatementFormat {
  CAMT053
  CSV
}

model BankStatement {
  id             String          @id @default(cuid())
  companyId      String
  bankAccountId  String
  format         StatementFormat
  fileName       String
  /// Panga väljavõtte tunnus (camt Stmt/Id)
  externalId     String?
  fromDate       DateTime?       @db.Date
  toDate         DateTime?       @db.Date
  openingBalance Decimal?        @db.Decimal(18, 2)
  closingBalance Decimal?        @db.Decimal(18, 2)
  createdAt      DateTime        @default(now())
  createdById    String?

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  lines       BankStatementLine[]

  @@unique([companyId, id])
  @@index([companyId, bankAccountId, createdAt(sort: Desc)])
}

enum StatementLineStatus {
  /// Sobivust ei leitud
  NEW
  /// Leitud soovitus, ootab kinnitust
  SUGGESTED
  /// Makse loodud või seotud
  DONE
  /// Kasutaja jättis vahele
  IGNORED
}

model BankStatementLine {
  id              String              @id @default(cuid())
  companyId       String
  statementId     String
  bankAccountId   String
  date            DateTime            @db.Date
  /// Märgiga: + laekumine, − väljamakse
  amount          Decimal             @db.Decimal(18, 2)
  currency        String              @default("EUR") @db.Char(3)
  partyName       String?
  partyIban       String?
  referenceNumber String?
  description     String?
  /// Panga unikaalne tehingu tunnus (topeltimpordi vältimiseks)
  bankReference   String?
  status          StatementLineStatus @default(NEW)
  /// Sobitamise soovitus (JSON: { kind, ids, confidence, … })
  suggestion      Json?
  paymentId       String?
  sortOrder       Int                 @default(0)

  statement BankStatement @relation(fields: [companyId, statementId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, id])
  @@index([companyId, statementId])
  @@index([companyId, bankAccountId, bankReference])
}

enum PaymentOrderStatus {
  CREATED
  PAID
}

/// Maksekorralduste fail (pain.001) tasumata ostuarvetest ja kuluaruannetest.
model PaymentOrder {
  id            String             @id @default(cuid())
  companyId     String
  status        PaymentOrderStatus @default(CREATED)
  /// pain.001 MsgId
  messageId     String
  bankAccountId String
  executionDate DateTime           @db.Date
  total         Decimal            @default(0) @db.Decimal(18, 2)
  createdAt     DateTime           @default(now())
  createdById   String?

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   PaymentOrderLine[]

  @@unique([companyId, id])
  @@index([companyId, createdAt(sort: Desc)])
}

model PaymentOrderLine {
  id                String  @id @default(cuid())
  companyId         String
  orderId           String
  purchaseInvoiceId String?
  expenseReportId   String?
  partyName         String
  iban              String
  amount            Decimal @db.Decimal(18, 2)
  referenceNumber   String?
  description       String?
  sortOrder         Int     @default(0)

  order PaymentOrder @relation(fields: [companyId, orderId], references: [companyId, id], onDelete: Cascade)

  @@index([companyId, orderId])
}
