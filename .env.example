# --- Andmebaas (Neon) ---------------------------------------------------------
# Vercelis seab Neoni Marketplace'i integratsioon selle automaatselt.
# Kasuta Neoni "pooled" ühendust (host sisaldab "-pooler").
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lilysokid"

# Ainult testidele (integratsioonitestid tühjendavad selle andmebaasi!). Nimi peab sisaldama "test".
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lilysokid_test"

# --- Auth.js ------------------------------------------------------------------
# Juhuslik saladus sessioonide krüpteerimiseks: openssl rand -base64 32
AUTH_SECRET=""

# Rakenduse avalik aadress (kutselinkide jaoks), nt https://lily-sokid.vercel.app
APP_URL="http://localhost:3000"

# --- E-post (Resend) ----------------------------------------------------------
# Kui RESEND_API_KEY puudub, kirjutatakse e-kirjad (magic link, kutsed) serveri logisse.
RESEND_API_KEY=""
# Saatja aadress; domeen peab olema Resendis kinnitatud.
EMAIL_FROM="LILY SOKID <noreply@sinudomeen.ee>"
# Tootmises keeldutakse arveid ilma RESEND_API_KEY-ta saatmast. Testkeskkonnas (E2E) saab
# kirjad logisse suunata: EMAIL_LOG_ONLY=1
EMAIL_LOG_ONLY=""

# --- Valikuline ---------------------------------------------------------------
# PRISMA_LOG=1 – logi SQL päringud

# Vercel Blob (ostuarvete ja tšekkide failid). Vercelis: Storage → Blob → Connect; muutuja lisatakse ise.
# Kui puudub, salvestatakse failid andmebaasi (sobib arenduseks ja väikesele mahule).
BLOB_READ_WRITE_TOKEN=""
